// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  CUSTOMER
  STORE_ADMIN
  SUPER_ADMIN
}

enum AddressStatus {
  PRIMARY
  SECONDARY
}

enum Unit {
  KG
  G
  PCS
  PACK
}

enum DietType {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  HALAL
}

enum ProductGrade {
  A
  B
  C
}

enum MutationStatus {
  PENDING
  PROCESSED
  SHIPPING
  REJECTED
  COMPLETED
}

enum TransactionStatus {
  PROCESSING
  SHIPPING
  CANCELED
  COMPLETED
}

enum DiscountType {
  BUY_ONE_GET_ONE
  MIN_TRANSACTION
  NO_REQUIREMENT
}

enum PaymentType {
  CARD 
  TRANSFER
}

enum PaymentStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  PAID
  CANCELED
}

enum ActivityType {
  MANUAL_ADD
  MANUAL_DEDUCT
  ORDER_REDUCTION
  ORDER_CANCELED
  MUTATION_IN
  MUTATION_OUT
}


model User {
  userId            String    @id @default(uuid())
  firstName         String    @db.VarChar(30)
  lastName          String    @db.VarChar(30)
  email             String    @unique @db.VarChar(30)
  phone             String    @unique @db.VarChar(15)
  gender            Gender
  role              Role
  password          String    @db.VarChar(30)
  isVerified        Boolean   @default(false)
  verificationToken String?
  tokenExpiresAt    DateTime?
  avatar            String?
  myReferralCode    String    @unique
  usedReferralCode  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  transactions Transaction[]
  addresses      Address[]
  refreshTokens  RefreshToken[]
  resetPasswords ResetPassword[]
  carts          Cart?
  stores         Store?

  voucherOwners ReferralVoucher? @relation("voucherOwner")
  referralOwner ReferralVoucher[] @relation("referralOwner")

  @@map("users")
}

model Address {
  addressId     String        @id @default(uuid())
  userId        String
  address       String        @db.VarChar(100)
  district      String        @db.VarChar(50)
  city          String        @db.VarChar(50)
  province      String        @db.VarChar(50)
  postalCode    String        @db.VarChar(5)
  addressStatus AddressStatus @default(SECONDARY)
  latitude      Float?
  longitude     Float?

  user User @relation(fields: [userId], references: [userId])
  transactions Transaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("addresses")
}

model RefreshToken {
  refreshTokenId String    @id @default(uuid())
  token          String    @unique @db.Text
  userId         String
  user           User      @relation(fields: [userId], references: [userId])
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@map("refreshTokens")
}

model ResetPassword {
  resetPasswordId String    @id @default(uuid())
  userId          String
  hashedToken     String    @unique @db.Text
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [userId])

  @@map("resetPasswords")
}

model Cart {
  cartId String @id @default(uuid())
  userId String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [userId])

  @@map("carts")
}

model CartItem {
  cartItemid String @id @default(uuid())
  cartId     String
  productId  String
  quantity   Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cart    Cart    @relation(fields: [cartId], references: [cartId])
  product Product @relation(fields: [productId], references: [productId])

  @@map("cartItems")
}

model ProductCategory {
  productCategoryId String @id @default(uuid())
  cateogry          String @unique @db.VarChar(30)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product?

  @@map("productCategories")
}

model Product {
  productId           String       @id @default(uuid())
  serialNumber        String       @unique @db.VarChar(15)
  name                String       @unique @db.VarChar(30)
  slug                String       @unique
  productCategoryId   String       @unique
  price               Decimal      @db.Decimal(10, 2)
  description         String       @db.VarChar(500)
  wightPerGram        Decimal
  unit                Unit
  storageInstructuins String?      @db.VarChar(150)
  grade               ProductGrade
  dietType            DietType

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  discounts Discount[]
  mutations       Mutation[]
  cartItems       CartItem[]
  stocks          Stock[]
  productPhotos   ProductPhoto[]
  productCategory ProductCategory @relation(fields: [productCategoryId], references: [productCategoryId])
  orderItems OrderItem?

  @@map("products")
}

model ProductPhoto {
  productPhotoId String @id @default(uuid())
  productId      String
  photoUrl       String

  product Product @relation(fields: [productId], references: [productId])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("productPhotos")
}

model Store {
  storeId    String  @id @default(uuid())
  userId     String  @unique
  name       String  @db.VarChar(30)
  address    String  @db.VarChar(100)
  district   String  @db.VarChar(50)
  city       String  @db.VarChar(50)
  province   String  @db.VarChar(50)
  postalCode String  @db.VarChar(5)
  latitude   Float?
  longitude  Float?
  phone      String  @db.VarChar(15)
  avatar     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User       @relation(fields: [userId], references: [userId])
  mutationsFrom Mutation[] @relation("fromStore")
  mutationsTo   Mutation[] @relation("toStore")
  stocks        Stock[]
  storeOrders StoreOrder[]
  

  @@map("stores")
}

model Stock {
  stocksId  String @id @default(uuid())
  storeId   String
  productId String
  stock     Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  store   Store   @relation(fields: [storeId], references: [storeId])
  product Product @relation(fields: [productId], references: [productId])
  stockJournals StockJournal[]

  @@map("stocks")
}

model StockJournal {
  stockJournalId String @id @default(uuid())
  stockId String
  quantityChange Int
  type ActivityType
  transactionId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stock Stock @relation(fields: [stockId], references: [stocksId])
  transaction Transaction? @relation(fields: [transactionId], references: [transactionId])
  @@map("stockJournals")
}

model Mutation {
  mutationid     String         @id @default(uuid())
  productId      String
  fromStoreId    String
  toStoreId      String
  quantity       Int
  mutationStatus MutationStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product   Product @relation(fields: [productId], references: [productId])
  fromStore Store   @relation("fromStore", fields: [fromStoreId], references: [storeId])
  toStore   Store   @relation("toStore", fields: [toStoreId], references: [storeId])

  @@map("mutations")
}


model Transaction {
  transactionId   String @id @default(uuid())
  transactionNumber String @db.VarChar(15) @unique
  userId String
  addressId String
  totalAmount Decimal
  totalDiscount Decimal
  grandTotal Decimal
  shippedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  payments Payment?
  user User @relation(fields: [userId], references: [userId])
  address Address @relation(fields: [addressId], references: [addressId])
  storeOrders StoreOrder[]
  referralVouchers ReferralVoucher?
  stockJournals StockJournal[]

  @@map("transactions")
}

model ReferralVoucher {
  referralVoucherId String @id @default(uuid())
  userId String @unique 
  referralOwnerId String 
  couponCode String @db.VarChar(8) @unique
  discountAmount Decimal
  validFrom DateTime
  validUntil DateTime
  transactionId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 

  voucherOwner User @relation("voucherOwner", fields: [userId], references: [userId])
  referralOwner User @relation("referralOwner", fields: [referralOwnerId], references: [userId])
  transaction Transaction? @relation(fields: [transactionId], references: [transactionId])

  @@map("referralVouchers")
}


model Payment {
  paymentId String @id @default(uuid())
  transactionId String @unique
  paymentGatewayId String?
  paymentType PaymentType
  paymentProof String?
  paymentStatus PaymentStatus
  expiresAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [transactionId])
  @@map("payments")
}

model Discount {
  discountId String @id @default(uuid())
  productId String 
  type DiscountType
  minTransaction Decimal?
  validUntil DateTime
  validFrom DateTime
  discountAmount Decimal

  storeOrders StoreOrder[]
  product Product @relation(fields: [productId], references: [productId])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("discounts")
}

model StoreOrder {
  storeOrderId String @id @default(uuid())
  transactionId String
  storeId String
  discountId String
  shippingCost Decimal
  totalAmount Decimal
  totalDiscountAmount Decimal
  grandTotal Decimal
  transactionStatus TransactionStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  store Store @relation(fields: [storeId], references: [storeId])
  discount Discount @relation(fields: [discountId], references: [discountId])
  transaction Transaction @relation(fields: [transactionId], references: [transactionId])
  orderItems OrderItem[]

  @@map("storeOrders")
}

model OrderItem {
  orderItemId String @id @default(uuid())
  storeOrderId String
  productId String @unique
  quantity Int
  unitPrice Decimal
  discountAmount Decimal
  subTotalItem Decimal

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  storeOrder StoreOrder @relation(fields: [storeOrderId], references: [storeOrderId])
  product Product @relation(fields: [productId], references: [productId])

  @@map("orderItems")
}
