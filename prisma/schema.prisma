generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  CUSTOMER
  STORE_ADMIN
  SUPER_ADMIN
}

enum AddressStatus {
  PRIMARY
  SECONDARY
}

enum StoreStatus {
  PRIMARY
  SECONDARY
}

enum Unit {
  KG
  G
  PCS
  PACK
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum DietType {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  HALAL
}

enum ProductGrade {
  A
  B
  C
}

enum MutationStatus {
  PENDING
  PROCESSED
  SHIPPING
  REJECTED
  COMPLETED
}

enum TransactionStatus {
  WAITING_FOR_PAYMENT
  PROCESSING
  SHIPPING
  CANCELED
  COMPLETED
}

enum DiscountType {
  BUY_ONE_GET_ONE
  MIN_TRANSACTION
  NO_REQUIREMENT
}

enum DiscountValueType {
  PERCENTAGE
  NOMINAL
}

enum PaymentType {
  GOPAY
  BANK_TRANSFER
  CREDIT_CARD
  SHOPEEPAY
  OVO
  DANA
  QRIS
  ALFAMART
  INDOMARET
  AKULAKU
  KREDIVO
  GOOGLE_PAY
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  DENIED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum ActivityType {
  MANUAL_ADD
  MANUAL_DEDUCT
  ORDER_REDUCTION
  ORDER_CANCELED
  MUTATION_IN
  MUTATION_OUT
}

model User {
  userId           String       @id @default(uuid())
  firstName        String       @db.VarChar(30)
  lastName         String       @db.VarChar(30)
  email            String       @unique @db.VarChar(30)
  phone            String?      @unique @db.VarChar(15)
  gender           Gender       @default(MALE)    
  role             Role         @default(CUSTOMER)
  password         String?      @db.VarChar(255)
  isVerified       Boolean      @default(false)
  authProvider     AuthProvider
  authProviderId   String?
  avatar           String?
  myReferralCode   String       @unique @db.VarChar(8)
  usedReferralCode String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  transactions        Transaction[]
  addresses           Address[]
  refreshTokens       RefreshToken[]
  resetPasswords      ResetPassword[]
  cart                Cart?
  store               Store?
  verifications       Verification[]
  freeShippingVoucher FreeShippingVoucher[]

  voucherOwners ReferralVoucher?  @relation("voucherOwner")
  referralOwner ReferralVoucher[] @relation("referralOwner")

  @@map("users")
}

model Address {
  addressId     String        @id @default(uuid())
  userId        String
  address       String        @db.VarChar(100)
  districtId    Int
  district      String        @db.VarChar(50)
  cityId        Int
  city          String        @db.VarChar(50)
  provinceId    Int
  province      String        @db.VarChar(50)
  postalCode    String        @db.VarChar(5)
  addressStatus AddressStatus @default(SECONDARY)
  latitude      Float?
  longitude     Float?

  user         User          @relation(fields: [userId], references: [userId])
  transactions Transaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("addresses")
}

model Verification {
  verificationId String    @id @default(uuid())
  userId         String
  hashedToken    String    @unique @db.Text
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [userId])

  @@map("verifications")
}

model RefreshToken {
  refreshTokenId String    @id @default(uuid())
  token          String    @unique @db.Text
  userId         String
  revoked        Boolean
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [userId])

  @@map("refreshTokens")
}

model ResetPassword {
  resetPasswordId String    @id @default(uuid())
  userId          String
  hashedToken     String    @unique @db.Text
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [userId])

  @@map("resetPasswords")
}

model Cart {
  cartId String @id @default(uuid())
  userId String @unique
  storeId String 

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [userId])
  store   Store         @relation(fields: [storeId], references: [storeId])

  @@map("carts")
}

model CartItem {
  cartItemId String @id @default(uuid())
  cartId     String
  productId  String
  quantity   Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cart    Cart    @relation(fields: [cartId], references: [cartId])
  product Product @relation(fields: [productId], references: [productId])

  @@map("cartItems")
  @@unique([cartId, productId])
}

model ProductCategory {
  productCategoryId String @id @default(uuid())
  category          String @unique @db.VarChar(30)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@map("productCategories")
}

model Product {
  productId           String       @id @default(uuid())
  serialNumber        String       @unique @db.VarChar(15)
  name                String       @unique @db.VarChar(30)
  slug                String       @unique
  productCategoryId   String
  price               Decimal      @db.Decimal(10, 2)
  description         String       @db.VarChar(500)
  weightPerGram       Decimal      @db.Decimal(10, 2)
  unit                Unit
  storageInstructions String?      @db.VarChar(150)
  grade               ProductGrade
  dietType            DietType

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  discounts       Discount[]
  mutations       Mutation[]
  cartItems       CartItem[]
  stocks          Stock[]
  productPhotos   ProductPhoto[]
  productCategory ProductCategory @relation(fields: [productCategoryId], references: [productCategoryId])
  orderItems      OrderItem[]

  @@map("products")
}

model ProductPhoto {
  productPhotoId String @id @default(uuid())
  productId      String
  photoUrl       String

  product Product @relation(fields: [productId], references: [productId])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("productPhotos")
}

model Store {
  storeId    String  @id @default(uuid())
  userId     String? @unique
  name       String  @db.VarChar(30)
  address    String  @db.VarChar(100)
  districtId Int
  district   String  @db.VarChar(50)
  cityId     Int
  city       String  @db.VarChar(50)
  provinceId Int
  province   String  @db.VarChar(50)
  postalCode String  @db.VarChar(5)
  latitude   Float?
  longitude  Float?
  phone      String  @db.VarChar(15)
  avatar     String?
  storeStatus   StoreStatus @default(SECONDARY)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  discounts      Discount[]
  user          User?         @relation(fields: [userId], references: [userId])
  mutationsFrom Mutation[]    @relation("fromStore")
  mutationsTo   Mutation[]    @relation("toStore")
  stocks        Stock[]
  transactions  Transaction[]
  carts         Cart[]

  @@map("stores")
}

model Stock {
  stockId   String @id @default(uuid())
  storeId   String
  productId String
  quantity  Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  store         Store          @relation(fields: [storeId], references: [storeId])
  product       Product        @relation(fields: [productId], references: [productId])
  stockJournals StockJournal[]

  @@unique([storeId, productId])
  @@map("stocks")
}

model StockJournal {
  stockJournalId String       @id @default(uuid())
  stockId        String
  quantityChange Int
  type           ActivityType
  transactionId  String?
  mutationId     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stock       Stock        @relation(fields: [stockId], references: [stockId])
  transaction Transaction? @relation(fields: [transactionId], references: [transactionId])
  mutation    Mutation?    @relation(fields: [mutationId], references: [mutationId])

  @@map("stockJournals")
}

model Mutation {
  mutationId     String         @id @default(uuid())
  productId      String
  fromStoreId    String
  toStoreId      String
  quantity       Int
  mutationStatus MutationStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product       Product        @relation(fields: [productId], references: [productId])
  fromStore     Store          @relation("fromStore", fields: [fromStoreId], references: [storeId])
  toStore       Store          @relation("toStore", fields: [toStoreId], references: [storeId])
  stockJournals StockJournal[]

  @@map("mutations")
}

model FreeShippingVoucher {
  freeShippingVoucherId    String  @id @default(uuid())
  userId                   String
  transactionId            String? @unique
  currentTotalTransactions Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user        User         @relation(fields: [userId], references: [userId])
  transaction Transaction? @relation(fields: [transactionId], references: [transactionId])

  @@map("freeShippingVouchers")
}

model Transaction {
  transactionId     String            @id @default(uuid())
  transactionNumber String            @unique @db.VarChar(15)
  userId            String
  addressId         String
  storeId           String
  discountId        String?
  totalAmount       Decimal           @db.Decimal(10, 2)
  shippingCost      Decimal           @db.Decimal(10, 2)
  totalDiscount     Decimal           @db.Decimal(10, 2)
  grandTotal        Decimal           @db.Decimal(10, 2)
  transactionStatus TransactionStatus
  processedAt       DateTime?         
  shippedAt         DateTime?
  cancelledAt       DateTime?
  completedAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  store      Store       @relation(fields: [storeId], references: [storeId])
  discount   Discount?   @relation(fields: [discountId], references: [discountId])
  orderItems OrderItem[]

  payments            Payment?
  user                User                 @relation(fields: [userId], references: [userId])
  address             Address              @relation(fields: [addressId], references: [addressId])
  referralVouchers    ReferralVoucher?
  stockJournals       StockJournal[]
  freeShippingVoucher FreeShippingVoucher?

  @@map("transactions")
}

model ReferralVoucher {
  referralVoucherId String   @id @default(uuid())
  userId            String   @unique
  referralOwnerId   String
  couponCode        String   @unique @db.VarChar(8)
  discountAmount    Decimal  @db.Decimal(10, 2)
  validFrom         DateTime
  validUntil        DateTime
  transactionId     String?  @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  voucherOwner  User         @relation("voucherOwner", fields: [userId], references: [userId])
  referralOwner User         @relation("referralOwner", fields: [referralOwnerId], references: [userId])
  transaction   Transaction? @relation(fields: [transactionId], references: [transactionId])

  @@map("referralVouchers")
}

model Payment {
  paymentId     String        @id @default(uuid())
  transactionId String        @unique
  snapToken     String
  paymentType   PaymentType
  paymentStatus PaymentStatus
  expiresAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [transactionId])

  @@map("payments")
}

model Discount {
  discountId     String            @id @default(uuid())
  productId      String
  storeId        String?           // 🆕 TAMBAHKAN INI agar diskon tidak bocor ke toko lain!
  type           DiscountType 
  valueType      DiscountValueType @default(NOMINAL) 
  
  discountAmount Decimal           @db.Decimal(10, 2) 
  minTransaction Decimal?          @db.Decimal(10, 2) 
  maxDiscount    Decimal?          @db.Decimal(10, 2) 
  
  validFrom      DateTime
  validUntil     DateTime

  transactions   Transaction[]
  product        Product           @relation(fields: [productId], references: [productId])
  store          Store?            @relation(fields: [storeId], references: [storeId]) // 🆕 Relasi ke Store

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@map("discounts")
}

model OrderItem {
  orderItemId    String  @id @default(uuid())
  transactionId  String
  productId      String
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2)
  subTotalItem   Decimal @db.Decimal(10, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [transactionId])
  product     Product     @relation(fields: [productId], references: [productId])

  @@map("orderItems")
}
